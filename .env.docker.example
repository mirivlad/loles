# Copy to .env for local Docker Compose (Portainer: use stack environment variables).
# Keep APP_KEY and DB_PASSWORD unchanged after the first deployment.
LOLES_PORT=8088
APP_URL=http://localhost:8088
APP_KEY=
DB_PASSWORD=

# Optional; only set to the known address/CIDR of your reverse proxy.
TRUSTED_PROXIES=
# Change to true when APP_URL is HTTPS and reverse proxy serves HTTPS.
SESSION_SECURE_COOKIE=false


# Optional example enterprises, groups, students, course and test.
# Enable for first deployment; disable after initial seed.
LOLES_DEMO_DATA=false
# Staff-managed accounts; no open self-registration by default.
LOLES_PUBLIC_REGISTRATION=false
